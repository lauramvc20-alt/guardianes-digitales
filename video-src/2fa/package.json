{
  "name": "pva-tutorial-2fa",
  "private": true,
  "version": "1.0.0",
  "description": "Tutorial en motion graphics sobre verificación en dos pasos (2FA) · Guardián Digital",
  "scripts": {
    "estudio": "remotion studio src/index.ts",
    "audio": "python3 audio/build_audio.py",
    "render": "remotion render src/index.ts Tutorial2FA out/tutorial-2fa.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k",
    "render:subtitulos": "remotion render src/index.ts Tutorial2FAConSubtitulos out/tutorial-2fa-subtitulado.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k",
    "poster": "remotion still src/index.ts Tutorial2FA out/poster.png --frame=75"
  },
  "dependencies": {
    "@remotion/cli": "4.0.544",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.544"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
